{
  "manifest_version": 3,
  "name": "Mirror",
  "version": "0.2.0",
  "description": "Notices doom-scrolling. Optional sync is encrypted before upload.",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "storage", "alarms", "idle", "notifications", "offscreen", "scripting"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://*.instagram.com/*", "https://*.tiktok.com/*", "https://*.x.com/*", "https://*.twitter.com/*", "https://*.reddit.com/*", "https://*.facebook.com/*", "https://*.threads.net/*", "https://*.threads.com/*", "https://*.bsky.app/*", "https://*.pinterest.com/*", "https://*.tumblr.com/*", "https://*.9gag.com/*", "https://*.netflix.com/*", "https://*.primevideo.com/*", "https://*.hotstar.com/*", "https://*.twitch.tv/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html" },
  "icons": { "128": "icon128.png" },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
