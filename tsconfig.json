{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["chrome", "node"],
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "erasableSyntaxOnly": true, "verbatimModuleSyntax": true, "skipLibCheck": true
  },
  "include": ["shared/src", "shared/test", "extension/src", "extension/test", "web/src", "ui"]
}
